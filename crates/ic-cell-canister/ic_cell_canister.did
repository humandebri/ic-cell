type CellError = variant {
  CasConflict : record {
    key : text;
    expected_generation : nat64;
    actual_generation : opt nat64;
  };
  AlreadyExists : record {
    key : text;
  };
  NotFound : record {
    key : text;
  };
  StaleEpoch : record {
    cell_id : text;
    expected_epoch : nat64;
    actual_epoch : nat64;
  };
  LeaseHeldByAnother : record {
    cell_id : text;
    current_owner : text;
    expires_at_ns : nat64;
  };
  NotOwner : record {
    cell_id : text;
  };
  ReplicationMismatch : record {
    reason : text;
  };
  Unauthorized;
  PreconditionFailed : record {
    reason : text;
  };
  Transport : text;
  InvalidArgument : text;
  Database : text;
};

type ObjectRecord = record {
  key : text;
  value : blob;
  generation : nat64;
  updated_at_ns : nat64;
};

type ObjectMeta = record {
  key : text;
  size : nat64;
  generation : nat64;
  updated_at_ns : nat64;
};

type LeaseRecord = record {
  cell_id : text;
  owner_id : text;
  epoch : nat64;
  expires_at_ns : nat64;
};

type SqlValue = variant {
  Null;
  Integer : int64;
  Real : float64;
  Text : text;
  Blob : blob;
};

type ExecResult = record {
  rows_affected : nat64;
  idempotent_replay : bool;
};

type QueryResult = record {
  rows : vec vec SqlValue;
};

type PageDelta = record {
  pgno : nat32;
  data : blob;
};

type LtxDeltaRequest = record {
  epoch : nat64;
  min_txid : nat64;
  max_txid : nat64;
  page_size : nat32;
  commit_pages : nat32;
  pre_apply_checksum : nat64;
  post_apply_checksum : nat64;
  pages : vec PageDelta;
  ltx_pre_apply_checksum : opt nat64;
  ltx_post_apply_checksum : opt nat64;
};

type ReplicationState = record {
  epoch : nat64;
  last_txid : nat64;
  last_checksum : nat64;
  page_count : nat32;
  ltx_checksum : nat64;
};

type InitArgs = record {
  authorized_callers : opt vec principal;
};

type Fencing = record { text; text; nat64 };

type CellOp = variant {
  KvPut : record { key : text; value : blob };
  KvDelete : record { key : text };
  KvDeleteAll;
  SetAlarm : opt nat64;
  AssertKv : record { key : text; expected : opt blob };
  Sql : record { sql : text; args : vec SqlValue };
};

type TransactRequest = record {
  fencing : Fencing;
  idempotency_key : opt text;
  ops : vec CellOp;
};

type OpResult = record {
  rows_affected : nat64;
  rows : vec vec SqlValue;
};

type TransactResult = record {
  results : vec OpResult;
  idempotent_replay : bool;
  epoch : nat64;
};

type KvEntry = record { key : text; value : blob };

type KvListOptions = record {
  prefix : opt text;
  start_after : opt text;
  limit : opt nat32;
  reverse : opt bool;
};

type KvListResult = record {
  entries : vec KvEntry;
  truncated : bool;
};

type DueAlarm = record { cell_id : text; at_ns : nat64 };

type Activation = record {
  lease : LeaseRecord;
  entries : vec KvEntry;
  complete : bool;
  alarm_at_ns : opt nat64;
};

service : (opt InitArgs) -> {
  add_authorized_caller : (principal) -> (variant { Ok : bool; Err : CellError });
  remove_authorized_caller : (principal) -> (variant { Ok : bool; Err : CellError });
  list_authorized_callers : () -> (variant { Ok : vec principal; Err : CellError }) query;

  acquire_lease : (text, text, nat64) -> (variant { Ok : LeaseRecord; Err : CellError });
  release_lease : (text, text, nat64) -> (variant { Ok; Err : CellError });
  get_lease : (text) -> (variant { Ok : opt LeaseRecord; Err : CellError });

  activate_cell : (text, text, nat64, nat64) -> (variant { Ok : Activation; Err : CellError });
  cell_transact : (TransactRequest) -> (variant { Ok : TransactResult; Err : CellError });
  cell_kv_get : (text, vec text) -> (variant { Ok : vec opt blob; Err : CellError });
  cell_kv_list : (text, KvListOptions) -> (variant { Ok : KvListResult; Err : CellError });
  cell_get_alarm : (text) -> (variant { Ok : opt nat64; Err : CellError });
  list_due_alarms : (nat32) -> (variant { Ok : vec DueAlarm; Err : CellError });

  put_object : (text, blob, nat64, opt Fencing) -> (variant { Ok : ObjectRecord; Err : CellError });
  get_object_strong : (text) -> (variant { Ok : opt ObjectRecord; Err : CellError });
  get_object_eventual : (text) -> (variant { Ok : opt ObjectRecord; Err : CellError }) query;
  head_object_strong : (text) -> (variant { Ok : opt ObjectMeta; Err : CellError });
  get_object_range_strong : (text, nat64, nat64) -> (variant { Ok : blob; Err : CellError });
  list_objects_strong : (text) -> (variant { Ok : vec ObjectMeta; Err : CellError });
  delete_object : (text, nat64, opt Fencing) -> (variant { Ok : bool; Err : CellError });

  put_object_chunk : (text, nat32, blob) -> (variant { Ok; Err : CellError });
  commit_chunked_object : (text, text, nat64, opt Fencing) -> (variant { Ok : ObjectMeta; Err : CellError });

  sql_execute : (text, vec SqlValue, opt text, opt Fencing) -> (variant { Ok : ExecResult; Err : CellError });
  sql_query_strong : (text, vec SqlValue) -> (variant { Ok : QueryResult; Err : CellError });
  sql_query_eventual : (text, vec SqlValue) -> (variant { Ok : QueryResult; Err : CellError }) query;

  gc_idempotency : (nat64) -> (variant { Ok : nat64; Err : CellError });
  abort_chunked_upload : (text) -> (variant { Ok : nat64; Err : CellError });

  apply_ltx_delta : (LtxDeltaRequest) -> (variant { Ok : ReplicationState; Err : CellError });
  stage_ltx_pages : (text, vec PageDelta) -> (variant { Ok : nat64; Err : CellError });
  commit_staged_ltx_delta : (text, LtxDeltaRequest) -> (variant { Ok : ReplicationState; Err : CellError });
  abort_staged_ltx : (text) -> (variant { Ok : nat64; Err : CellError });
  get_replication_state : () -> (ReplicationState) query;
}
